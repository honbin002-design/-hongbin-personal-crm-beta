{
  "name": "鴻繽科技 CRM R74｜GitHub 專用隔離測試",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "forwardPorts": [
    4174
  ],
  "portsAttributes": {
    "4174": {
      "label": "R74 TEST（獨立來源、僅供本人）",
      "onAutoForward": "notify",
      "visibility": "private"
    }
  },
  "postStartCommand": "nohup python3 .devcontainer/r74_server.py --port 4174 --bind 0.0.0.0 >/tmp/r74-test-http.log 2>&1 < /dev/null &",
  "customizations": {
    "vscode": {
      "settings": {
        "workbench.startupEditor": "none"
      }
    }
  }
}

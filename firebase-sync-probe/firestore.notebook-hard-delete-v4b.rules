rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Independent Google-first alternative ONLY. NEVER deploy unreviewed rules.
    // Verified Google identity alone is NOT permission to use HONBIN CRM.
    // __OWNER_UID__ is substituted ONLY locally in the user's deployment
    // helper after Firebase Authentication verifies the intended owner.
    function rawGoogleUser() {
      return request.auth != null
        && request.auth.uid is string
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }
    function accountOwner() {
      return rawGoogleUser() && request.auth.uid == '__OWNER_UID__';
    }
    function approvalPath(email) {
      return /databases/$(database)/documents/approvedAccounts/$(email);
    }
    function googleUser() {
      return rawGoogleUser() && (
        accountOwner()
        || (exists(approvalPath(request.auth.token.email.lower()))
          && get(approvalPath(request.auth.token.email.lower())).data.email
               == request.auth.token.email.lower()
          && get(approvalPath(request.auth.token.email.lower())).data.status == 'ACTIVE')
      );
    }
    function groupPath(groupId) {
      return /databases/$(database)/documents/groups/$(groupId);
    }
    function memberPath(groupId, uid) {
      return /databases/$(database)/documents/groups/$(groupId)/members/$(uid);
    }

    // Invite ID is unpredictable and invitations stay under the recipient
    // Google email's own inbox. Neither email nor the browser is an actor ID.
    function invitationPath(email, invitationId) {
      return /databases/$(database)/documents/inboxes/$(email)/invites/$(invitationId);
    }
    function verifiedGoogleEmail(email) {
      return googleUser()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == email;
    }
    function inviteRedemption(groupId, invitationId, role) {
      return googleUser() && groupActive(groupId)
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && invitationId is string
        && exists(invitationPath(request.auth.token.email.lower(), invitationId))
        && get(invitationPath(request.auth.token.email.lower(), invitationId)).data.groupId == groupId
        && get(invitationPath(request.auth.token.email.lower(), invitationId)).data.recipientEmail
             == request.auth.token.email.lower()
        && get(invitationPath(request.auth.token.email.lower(), invitationId)).data.role == role
        && get(invitationPath(request.auth.token.email.lower(), invitationId)).data.status == 'PENDING'
        && getAfter(invitationPath(request.auth.token.email.lower(), invitationId)).data.status == 'ACCEPTED'
        && getAfter(invitationPath(request.auth.token.email.lower(), invitationId)).data.acceptedUid
             == request.auth.uid;
    }
    function recipientMembershipRedemption(groupId, memberUid) {
      return googleUser() && groupActive(groupId) && memberUid == request.auth.uid
        && request.resource.data.keys().hasAll(['uid','role','status','invitationId'])
        && request.resource.data.keys().hasOnly(['uid','role','status','invitationId'])
        && request.resource.data.uid == memberUid
        && request.resource.data.status == 'ACTIVE'
        && request.resource.data.role in ['ADMIN','EDITOR','VIEWER']
        && inviteRedemption(groupId, request.resource.data.invitationId,
              request.resource.data.role);
    }
    function groupOwner(groupId) {
      return googleUser() && exists(groupPath(groupId))
        && get(groupPath(groupId)).data.ownerUid == request.auth.uid;
    }
    // The old live notebooks do not have deleteState: they remain ACTIVE.
    // Exactly one owner-initiated, irreversible DELETING transition is allowed.
    // This candidate grants NO final root-document deletion. Firestore Rules
    // cannot prove a dynamic collection has zero documents from a client.
    function groupActive(groupId) {
      return exists(groupPath(groupId))
        && !get(groupPath(groupId)).data.keys().hasAny(['deleteState']);
    }
    function cleanupOwner(groupId) {
      return groupOwner(groupId)
        && get(groupPath(groupId)).data.get('deleteState', '') == 'DELETING'
        && get(groupPath(groupId)).data.deletionId is string;
    }
    function activeMember(groupId) {
      return googleUser() && exists(memberPath(groupId, request.auth.uid))
        && get(memberPath(groupId, request.auth.uid)).data.status == 'ACTIVE';
    }
    function canViewGroup(groupId) {
      return groupActive(groupId)
        && (groupOwner(groupId) || activeMember(groupId));
    }
    function canEditGroup(groupId) {
      return groupActive(groupId)
        && (groupOwner(groupId)
          || (activeMember(groupId)
          && get(memberPath(groupId, request.auth.uid)).data.role in ['ADMIN', 'EDITOR']));
    }
    function canAdminGroup(groupId) {
      return groupActive(groupId)
        && (groupOwner(groupId)
          || (activeMember(groupId)
          && get(memberPath(groupId, request.auth.uid)).data.role == 'ADMIN'));
    }
    function basicNote(data) {
      return data.keys().hasOnly([
          'ownerUid', 'groupId', 'title', 'content', 'createdAt',
          'updatedAt', 'version', 'deleted'
        ])
        && data.keys().hasAll([
          'ownerUid', 'groupId', 'title', 'content', 'createdAt',
          'updatedAt', 'version', 'deleted'
        ])
        && data.ownerUid is string && data.title is string
        && data.title.size() <= 120
        && data.content is string && data.content.size() > 0
        && data.content.size() <= 30000
        && data.version is int && data.version >= 1
        && data.deleted is bool
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    function safeNoteUpdate() {
      // Deleted notes are tombstones: never resurrect or rewrite their
      // former content through a forged version increment.
      return resource.data.deleted == false
        && basicNote(request.resource.data)
        && request.resource.data.version == resource.data.version + 1
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['title', 'content', 'updatedAt', 'version', 'deleted']);
    }

    // Firebase Auth UID, not caller-provided email, is the durable identity.
    match /users/{ownerUid}/notes/{noteId} {
      allow get, list: if googleUser() && request.auth.uid == ownerUid;
      allow create: if googleUser() && request.auth.uid == ownerUid
        && basicNote(request.resource.data)
        && request.resource.data.ownerUid == ownerUid
        && request.resource.data.groupId == null
        && request.resource.data.version == 1
        && request.resource.data.deleted == false;
      allow update: if googleUser() && request.auth.uid == ownerUid
        && safeNoteUpdate();
      allow delete: if googleUser() && request.auth.uid == ownerUid;
    }

    // User-owned discovery POINTERS only: never expose groups globally.
    // Pointer contains no group title or other members' details.
    // The client must get the actual group document separately; revoked
    // members receive permission-denied even when their stale pointer remains.
    match /users/{ownerUid}/groupIndex/{groupId} {
      // Owner may get ONLY this exact pointer during cleanup, never list
      // another account's entire personal group directory.
      allow get: if (googleUser() && request.auth.uid == ownerUid)
        || cleanupOwner(groupId);
      allow list: if googleUser() && request.auth.uid == ownerUid;
      allow create: if googleUser() && request.auth.uid == ownerUid
        && request.resource.data.keys().hasOnly(['uid','groupId','createdAt'])
        && request.resource.data.keys().hasAll(['uid','groupId','createdAt'])
        && request.resource.data.uid == ownerUid
        && request.resource.data.groupId == groupId
        && request.resource.data.createdAt is timestamp
        && (
          canViewGroup(groupId)
          // Create owner pointer atomically ONLY if the group did not exist
          // before this batch. A DELETING group can never regain pointers.
          || (!exists(groupPath(groupId))
            && getAfter(groupPath(groupId)).data.ownerUid == ownerUid)
        );
      allow update: if false;
      // During DELETING the actual notebook owner may remove exact member
      // pointers in other users' directories, but may NOT list those dirs.
      allow delete: if (googleUser() && request.auth.uid == ownerUid)
        || cleanupOwner(groupId);
    }

    match /groups/{groupId} {
      allow get: if canViewGroup(groupId) || cleanupOwner(groupId);
      // Group discovery needs a separately designed, permission-checked index.
      allow list: if false;
      allow create: if googleUser()
        && request.resource.data.keys().hasOnly(['ownerUid','name','createdAt'])
        && request.resource.data.keys().hasAll(['ownerUid','name','createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.createdAt is timestamp;
      allow update: if groupOwner(groupId) && groupActive(groupId)
        && (
          // Same safe name-only editing as the published v2 rules.
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 120)
          // One-way, idempotency-keyed deletion LOCK, not final deletion.
          || (request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['deleteState','deletionId','deletingAt'])
            && request.resource.data.keys().hasAll(['deleteState','deletionId','deletingAt'])
            && request.resource.data.keys().hasOnly([
              'ownerUid','name','createdAt','deleteState','deletionId','deletingAt'])
            && request.resource.data.deleteState == 'DELETING'
            && request.resource.data.deletionId is string
            && request.resource.data.deletionId.size() >= 16
            && request.resource.data.deletionId.size() <= 180
             && request.resource.data.deletingAt is timestamp
             && request.resource.data.ownerUid == resource.data.ownerUid
             && request.resource.data.name == resource.data.name
             && request.resource.data.createdAt == resource.data.createdAt)
        );
      // Root removal cannot be authorized from an untrusted browser scan.
      allow delete: if false;
      match /members/{memberUid} {
        allow get: if canAdminGroup(groupId) || cleanupOwner(groupId)
          || (groupActive(groupId) && googleUser() && memberUid == request.auth.uid);
        allow list: if canAdminGroup(groupId) || cleanupOwner(groupId);
        // The immutable group owner is implicitly ADMIN and cannot be revoked.
        // Join is invitation-only, including when the caller is ADMIN.
        // A group admin may INVITE but cannot directly insert a member by
        // guessing UID. The Google-email holder must accept the invite in
        // the same atomic batch as membership creation.
        allow create: if memberUid != get(groupPath(groupId)).data.ownerUid
          && recipientMembershipRedemption(groupId, memberUid);
        allow update: if (canAdminGroup(groupId)
          && memberUid != get(groupPath(groupId)).data.ownerUid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['role','status'])
          && request.resource.data.role in ['ADMIN','EDITOR','VIEWER']
          && request.resource.data.status in ['ACTIVE','REVOKED']
          // Revoked membership may only be restored through a brand-new
          // verified-email invitation, never by admin flipping the status.
          && (resource.data.status == 'ACTIVE'
              || request.resource.data.status == 'REVOKED'))
          || (memberUid != get(groupPath(groupId)).data.ownerUid
            && resource.data.status == 'REVOKED'
            && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['role','status','invitationId'])
            && request.resource.data.invitationId != resource.data.get('invitationId', '')
            && recipientMembershipRedemption(groupId, memberUid));
        allow delete: if cleanupOwner(groupId)
          && resource.data.uid == memberUid;
      }

      // Admin-only directory of sent invitations. Index is permanent but
      // deliberately has no recipient note content or auth credential.
      // Creating the index requires the corresponding real email invite
      // to exist in the same committed server-side state.
      match /sentInvites/{invitationId} {
        allow get, list: if canAdminGroup(groupId) || cleanupOwner(groupId);
        allow create: if canAdminGroup(groupId)
          && request.resource.data.keys().hasOnly([
            'groupId','recipientEmail','role','invitedBy','createdAt'])
          && request.resource.data.keys().hasAll([
            'groupId','recipientEmail','role','invitedBy','createdAt'])
          && request.resource.data.groupId == groupId
          && request.resource.data.invitedBy == request.auth.uid
          && request.resource.data.recipientEmail is string
          && request.resource.data.recipientEmail.size() <= 254
          && request.resource.data.role in ['ADMIN','EDITOR','VIEWER']
          && request.resource.data.createdAt is timestamp
          && getAfter(invitationPath(request.resource.data.recipientEmail,
                            invitationId)).data.groupId == groupId
          && getAfter(invitationPath(request.resource.data.recipientEmail,
                            invitationId)).data.recipientEmail
               == request.resource.data.recipientEmail
          && getAfter(invitationPath(request.resource.data.recipientEmail,
                            invitationId)).data.role == request.resource.data.role
          && getAfter(invitationPath(request.resource.data.recipientEmail,
                            invitationId)).data.invitedBy == request.auth.uid
          && getAfter(invitationPath(request.resource.data.recipientEmail,
                            invitationId)).data.status == 'PENDING';
        allow update: if false;
        allow delete: if cleanupOwner(groupId)
          && resource.data.groupId == groupId;
      }

      match /notes/{noteId} {
        // Only the notebook creator can inspect all notes after the LOCK.
        allow get, list: if canViewGroup(groupId) || cleanupOwner(groupId);
        allow create: if canEditGroup(groupId)
          && basicNote(request.resource.data)
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.groupId == groupId
          && request.resource.data.version == 1
          && request.resource.data.deleted == false;
        // EDITOR may edit text but only ADMIN may soft-delete a shared
        // article. The direct hard-delete rule below already is admin-only.
        allow update: if canEditGroup(groupId) && safeNoteUpdate()
          && (request.resource.data.deleted == resource.data.deleted
              || canAdminGroup(groupId));
        allow delete: if canAdminGroup(groupId) || cleanupOwner(groupId);
      }
    }

    // An invite can be created by group ADMIN for a recipient's verified
    // Google email. Recipient may read ONLY their own exact inbox path.
    // Acceptance MUST be in the same atomic Firestore write batch as joining.
    match /inboxes/{recipientEmail}/invites/{invitationId} {
      // A group's ADMIN can inspect a specific invitation already
      // identified in its group-scoped sentInvites directory, but cannot
      // enumerate a recipient's whole inbox or other groups' invites.
      allow get: if verifiedGoogleEmail(recipientEmail)
        || (googleUser() && canAdminGroup(resource.data.groupId))
        || (resource.data.recipientEmail == recipientEmail
          && cleanupOwner(resource.data.groupId));
      allow list: if verifiedGoogleEmail(recipientEmail);
      allow create: if googleUser()
        && recipientEmail is string
        && recipientEmail.size() <= 254
        && recipientEmail.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && request.resource.data.keys().hasOnly([
          'groupId','recipientEmail','role','status','invitedBy'])
        && request.resource.data.keys().hasAll([
          'groupId','recipientEmail','role','status','invitedBy'])
        && request.resource.data.recipientEmail == recipientEmail
        && request.resource.data.invitedBy == request.auth.uid
        && request.resource.data.role in ['ADMIN','EDITOR','VIEWER']
        && request.resource.data.status == 'PENDING'
        && canAdminGroup(request.resource.data.groupId);
      allow update: if (
        // Admin can cancel an unused invite; accepted invites stay consumed.
        canAdminGroup(resource.data.groupId)
        && resource.data.status == 'PENDING'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status'])
        && request.resource.data.status == 'REVOKED'
      ) || (
        // No email self-assertion: Firebase-signed, verified Google email only.
        verifiedGoogleEmail(recipientEmail)
        && groupActive(resource.data.groupId)
        && resource.data.status == 'PENDING'
        && request.resource.data.status == 'ACCEPTED'
        && request.resource.data.acceptedUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status','acceptedUid'])
        // Must create / re-activate the exact matching UID membership atomically.
        && getAfter(memberPath(resource.data.groupId, request.auth.uid)).data.uid
             == request.auth.uid
        && getAfter(memberPath(resource.data.groupId, request.auth.uid)).data.role
             == resource.data.role
        && getAfter(memberPath(resource.data.groupId, request.auth.uid)).data.status
             == 'ACTIVE'
        && getAfter(memberPath(resource.data.groupId, request.auth.uid)).data.invitationId
             == invitationId
      );
      // Every email invitation is deleted by the owner of its EXACT
      // recorded notebook; other emails and other notebooks are untouched.
      allow delete: if resource.data.recipientEmail == recipientEmail
        && cleanupOwner(resource.data.groupId);
    }
    // Only the verified, fixed owner UID may administer global access.
    // A notebook ADMIN cannot authorize new CRM accounts.
    match /approvedAccounts/{email} {
      allow get, list: if accountOwner();
      allow create: if accountOwner()
        && email is string && email.size() <= 254
        && email.matches('.*@.*[.].*')
        && email == email.lower()
        && request.resource.data.keys().hasOnly(['email','status','createdAt'])
        && request.resource.data.keys().hasAll(['email','status','createdAt'])
        && request.resource.data.email == email
        && request.resource.data.status == 'ACTIVE'
        && request.resource.data.createdAt is timestamp;
      allow update: if accountOwner()
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['ACTIVE','REVOKED'];
      allow delete: if accountOwner();
    }
    // No wildcard allowance: every other path must fail closed.
  }
}
